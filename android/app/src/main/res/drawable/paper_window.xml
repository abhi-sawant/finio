<?xml version="1.0" encoding="utf-8"?>
<!-- The note-paper gradient as the window background, so a cold start never flashes white.
     (CSS is 172deg; a vertical gradient is indistinguishable at window scale.) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/paper_middle"
        android:endColor="@color/paper_bottom"
        android:startColor="@color/paper_top"
        android:type="linear" />
</shape>
